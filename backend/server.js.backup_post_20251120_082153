const express = require('express');
const cors = require('cors');
const dotenv = require('dotenv');
const http = require('http');
const { Server } = require('socket.io');

dotenv.config({ path: './config/config.env' });

const { sequelize } = require('./models');
const app = express();
const server = http.createServer(app);

// Socket.io 설정
const io = new Server(server, {
    cors: {
        origin: true,  // 모든 origin 허용 (개발용)
        credentials: true
    }
});

// Socket.io 연결
io.on('connection', (socket) => {
    console.log('✓ Socket 연결:', socket.id);
    
    socket.on('disconnect', () => {
        console.log('✗ Socket 연결 해제:', socket.id);
    });
});

// CORS 설정
app.use(cors({
    origin: true,  // 모든 origin 허용 (개발용)
    credentials: true
}));

app.use(express.json());
app.use(express.urlencoded({ extended: true }));

// 라우트
app.get('/', (req, res) => {
    res.json({ 
        message: 'Instagram Clone API with MariaDB',
        version: '1.0.0'
    });
});

app.get('/api/health', (req, res) => {
    res.json({ 
        status: 'OK', 
        message: 'MariaDB Backend Running',
        timestamp: new Date().toISOString()
    });
});

app.use('/auth', require('./routes/auth'));
app.use('/api/users', require('./routes/users'));
app.use('/api/posts', require('./routes/posts'));

// 404 핸들러
app.use((req, res) => {
    res.status(404).json({
        success: false,
        message: 'API 엔드포인트를 찾을 수 없습니다'
    });
});

// 에러 핸들러
app.use((err, req, res, next) => {
    console.error('Error:', err);
    res.status(500).json({ 
        success: false, 
        message: err.message 
    });
});

const PORT = process.env.PORT || 8000;

sequelize.authenticate()
    .then(() => {
        console.log('✓ MariaDB 연결 성공');
        server.listen(PORT, '0.0.0.0', () => {
            console.log('\n========================================');
            console.log(`✓ 서버 실행: http://0.0.0.0:${PORT}`);
            console.log(`✓ 외부 접속: http://${process.env.CLIENT_URL || 'localhost:3000'}`);
            console.log('========================================\n');
        });
    })
    .catch(err => {
        console.error('✗ 연결 실패:', err);
        process.exit(1);
    });

// Socket.io를 다른 모듈에서 사용할 수 있도록 export
module.exports = { io };
